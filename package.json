{
  "name": "grimmory-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for Grimmory book management",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bannert1337/grimmory-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "grimmory",
    "books",
    "library",
    "reading",
    "claude",
    "ai"
  ],
  "author": "bannert1337",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bannert1337/grimmory-mcp/issues"
  },
  "homepage": "https://github.com/bannert1337/grimmory-mcp#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "bun-types": "1.3.11",
    "typescript": "^5.8.0",
    "vitest": "^4.1.2"
  }
}